{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "<YOUR_WORKSPACE_PATH>"
      ]
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<YOUR_GITHUB_TOKEN_HERE>"
      }
    },
    "hexstrike-ai": {
      "command": "<YOUR_.venv/bin_PATH>/python",
      "args": [
        "<YOUR_hexstrike_mcp.py_PATH>",
        "--server",
        "http://YOUR_HEXSTRIKE_SERVER:8888"
      ]
    }
  }
}
