# VibeHackAI Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# =============================================================================
# REQUIRED FOR FULL FUNCTIONALITY
# =============================================================================

# Shodan API - https://account.shodan.io/
SHODAN_API_KEY=

# Snyk API - https://app.snyk.io/account
SNYK_TOKEN=

# GitHub API - https://github.com/settings/tokens
# Required scopes: repo, read:org
GITHUB_PERSONAL_ACCESS_TOKEN=

# =============================================================================
# OPTIONAL - Enhanced Features
# =============================================================================

# WhoisXML API - https://whoisxmlapi.com/
WHOISXMLAPI_API_KEY=

# =============================================================================
# METASPLOIT CONFIGURATION
# Only needed if using Metasploit MCP
# =============================================================================

MSF_PASSWORD=
MSF_SERVER=127.0.0.1
MSF_PORT=55553
MSF_SSL=false

# =============================================================================
# BURP SUITE CONFIGURATION
# Only needed if using Burp Suite MCP
# =============================================================================

BURP_MCP_PROXY_JAR_PATH=

# =============================================================================
# PATHS
# =============================================================================

# Workspace directory for sessions
WORKSPACE_ROOT=./workspace

# External MCP server directories (if installed locally)
CVE_SEARCH_MCP_DIR=
METASPLOIT_MCP_DIR=
