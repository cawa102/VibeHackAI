{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/path/to/your/workspace"
      ]
    },
    "nmap": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-nmap-server"
      ]
    },
    "shodan": {
      "command": "npx",
      "args": [
        "-y",
        "@burtthecoder/mcp-shodan"
      ],
      "env": {
        "SHODAN_API_KEY": "YOUR_SHODAN_API_KEY"
      }
    },
    "whoisxmlapi": {
      "command": "npx",
      "args": [
        "-y",
        "@whoisxmlapidotcom/mcp-whoisxmlapi"
      ],
      "env": {
        "WHOISXMLAPI_API_KEY": "YOUR_WHOISXMLAPI_API_KEY"
      }
    },
    "burpsuite": {
      "command": "java",
      "args": [
        "-jar",
        "${BURP_MCP_PROXY_JAR_PATH}",
        "--sse-url",
        "http://127.0.0.1:9876"
      ]
    },
    "snyk": {
      "command": "snyk",
      "args": [
        "test",
        "--json"
      ],
      "env": {
        "SNYK_TOKEN": "YOUR_SNYK_TOKEN"
      }
    },
    "cve-search": {
      "command": "uv",
      "args": [
        "--directory",
        "${CVE_SEARCH_MCP_DIR}",
        "run",
        "main.py"
      ]
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    },
    "gitlab": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://gitlab.com/api/v4/mcp"
      ]
    },
    "metasploit": {
      "command": "python",
      "args": [
        "${METASPLOIT_MCP_DIR}/MetasploitMCP.py",
        "--transport",
        "stdio"
      ],
      "env": {
        "MSF_PASSWORD": "YOUR_MSF_PASSWORD",
        "MSF_SERVER": "127.0.0.1",
        "MSF_PORT": "55553",
        "MSF_SSL": "false"
      }
    },
    "kali": {
      "command": "mcp-server",
      "args": [
        "--server",
        "http://localhost:5000",
        "--timeout",
        "300"
      ]
    }
  }
}
